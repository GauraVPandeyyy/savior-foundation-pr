# Public site URL. Set the real production domain before launch.
NEXT_PUBLIC_SITE_URL=https://your-real-domain.example

# Forms / email (server-side only except destination may also be shown publicly)
GMAIL_USER=shiwendrakumarshuklarbl@gmail.com

GMAIL_APP_PASSWORD=abcdefghijklmnop

FORM_DESTINATION_EMAIL=shiwendrakumarshuklarbl@gmail.com

# Optional Cloudflare Turnstile spam protection
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Razorpay — server-side secrets
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxx
NEXT_PUBLIC_RAZORPAY_ENABLED=false
MIN_DONATION_INR=100
MAX_DONATION_INR=500000

# Donation persistence using Supabase REST (portable across Netlify/Hostinger)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxx
# Production should keep this true. Set false only for local UI testing.
REQUIRE_DONATION_STORE=true
